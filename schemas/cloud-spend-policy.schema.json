{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orange-lee-tech/Artificial-Intelligence/blob/main/schemas/cloud-spend-policy.schema.json",
  "title": "PACS Phase 2 Cloud Spend Policy",
  "description": "Static configuration contract only. Runtime must additionally enforce cumulative budgets atomically, price validation, and egress coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "currency",
    "timezone",
    "daily_cap_fen",
    "per_request_cap_fen",
    "periods",
    "rollover",
    "unknown_cost_action",
    "cloud_routing"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "CNY"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA timezone verified on target host."
    },
    "daily_cap_fen": {
      "const": 200
    },
    "per_request_cap_fen": {
      "const": 20
    },
    "periods": {
      "type": "array",
      "description": "Exact approved schedule; no reordering or budget changes.",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "start",
            "base_cap_fen"
          ],
          "properties": {
            "name": {
              "const": "night"
            },
            "start": {
              "const": "00:00"
            },
            "base_cap_fen": {
              "const": 50
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "start",
            "base_cap_fen"
          ],
          "properties": {
            "name": {
              "const": "morning"
            },
            "start": {
              "const": "07:00"
            },
            "base_cap_fen": {
              "const": 50
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "start",
            "base_cap_fen"
          ],
          "properties": {
            "name": {
              "const": "afternoon"
            },
            "start": {
              "const": "12:00"
            },
            "base_cap_fen": {
              "const": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "start",
            "base_cap_fen"
          ],
          "properties": {
            "name": {
              "const": "evening"
            },
            "start": {
              "const": "18:00"
            },
            "base_cap_fen": {
              "const": 50
            }
          }
        }
      ]
    },
    "rollover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "scope",
        "method"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "scope": {
          "const": "same_local_day_only"
        },
        "method": {
          "const": "cumulative_accrual"
        }
      }
    },
    "unknown_cost_action": {
      "const": "deny"
    },
    "cloud_routing": {
      "const": "adaptive_local_first"
    }
  }
}
