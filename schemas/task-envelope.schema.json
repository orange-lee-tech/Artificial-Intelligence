{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacs.local/schemas/task-envelope.schema.json",
  "title": "PACS Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "goal", "acceptance_criteria"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "context": {"type": "array", "items": {"type": "object", "properties": {"fact": {"type": "string"}, "source": {"type": "string"}, "observed_at": {"type": "string"}}, "required": ["fact"]}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "object", "properties": {"type": {"type": "string"}, "reference": {"type": "string"}, "description": {"type": "string"}}, "required": ["type"]}},
    "expected_output": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "autonomy_level": {"enum": ["A0", "A1", "A2", "A3"]},
    "tools_allowed": {"type": "array", "items": {"type": "string"}},
    "approval_required": {"type": "boolean"},
    "deadline": {"type": "string"},
    "owner": {"type": "string"}
  }
}
